# ════════════════════════════════════════════════════════════
# INDYKPOL - PRODUCTION ENVIRONMENT VARIABLES FOR NETLIFY
# ════════════════════════════════════════════════════════════
# Site: bright-basbousa-82e300
# Generated: 2026-09-02
# ════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (Choose ONE)
# ─────────────────────────────────────────────────────────────

# OPTION 1: MySQL (Render, Railway, etc.)
DATABASE_TYPE=mysql
DATABASE_URL=mysql://username:password@host:3306/indykpol

# OR OPTION 2: Turso/LibSQL (SQLite in cloud)
# TURSO_DB_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# ─────────────────────────────────────────────────────────────
# SECURITY SECRETS (Generate strong random values!)
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=GENERATE_32_CHAR_RANDOM_SECRET_HERE_MIN_32_CHARS
API_KEY_PEPPER=GENERATE_32_CHAR_RANDOM_SECRET_HERE_MIN_32_CHARS

# ─────────────────────────────────────────────────────────────
# DEMO MODE (Public workspace without login)
# ─────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_COMPANY_ID=1
VITE_DEMO_MODE=true

# ─────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Leave empty to use same Netlify domain for API calls
VITE_API_URL=

# ════════════════════════════════════════════════════════════
# INSTRUCTIONS
# ════════════════════════════════════════════════════════════
# 1. Replace DATABASE_URL with your actual connection string
# 2. Generate two strong 32+ character secrets and set them above
# 3. Paste all variables into:
#    → Netlify → Site configuration → Environment
# 4. Click "Deploy site" to rebuild with new env vars
# 5. Open: https://bright-basbousa-82e300.netlify.app
# ════════════════════════════════════════════════════════════
