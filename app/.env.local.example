# BTE HYBRID — LOCAL DEVELOPMENT (szablon; skopiuj do .env)
# Baza: LOKALNA / DEVELOPMENT — nigdy produkcja.
# Start bazy: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=mysql://bte:bte_dev_local@127.0.0.1:3307/bte_dev
APP_ID=bte-local
APP_SECRET=local-dev-secret-not-for-production
VITE_APP_ID=bte-local
OWNER_UNION_ID=dev-owner

# Placeholdery OAuth — bez prawdziwego serwera Kimi auth logowanie OAuth jest
# nieaktywne, a reszta systemu działa normalnie. Do testów API użyj dev-login
# (docs/BTE_LOCAL_DEV.md — podpisany lokalnie token kimi_sid).
KIMI_AUTH_URL=http://127.0.0.1:9999
KIMI_OPEN_URL=http://127.0.0.1:9999
VITE_KIMI_AUTH_URL=http://127.0.0.1:9999

