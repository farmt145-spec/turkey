# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database (Turso SQLite) ─────────────────────────────────────
TURSO_DB_URL=             # libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=         # Turso auth token
DATABASE_URL=             # Optional local/dev fallback (legacy)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_API_URL=             # Public backend base URL, e.g. https://site.netlify.app/.netlify/functions
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
NODE_ENV=development      # Set production on Netlify production runtime
FRONTEND_URL=             # Frontend URL, e.g. https://your-site.netlify.app
CORS_ORIGIN=              # Optional alias for FRONTEND_URL
JWT_SECRET=               # Required in production; keep it only on the backend
DEMO_MODE=false           # true to expose legacy /api/demo-login in node runtime
DEMO_COMPANY_ID=          # company ID containing only demo data; required when DEMO_MODE=true
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
