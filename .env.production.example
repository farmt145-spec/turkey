# ── Indykpol Production Environment (TEMPLATE) ────────────────────
# Netlify: bright-basbousa-82e300
# Railway: melodious-fulfillment (MySQL)
#
# ⚠️  DO NOT commit real secrets to git!
# This is a TEMPLATE. Real values must be set in Netlify UI only.
# See: https://app.netlify.com/sites/bright-basbousa-82e300/configuration/environment

# ── Database (Railway MySQL) ────────────────────────────────────────
DATABASE_TYPE=mysql
DATABASE_URL=mysql://[MYSQL_USER]:[MYSQL_PASSWORD]@indykpol.railway.internal:3306/[MYSQL_DATABASE]

# ── Session & API Security (GENERATE STRONG SECRETS) ────────────────
SESSION_SECRET=[RUN: node scripts/generate-secrets.js]
API_KEY_PEPPER=[RUN: node scripts/generate-secrets.js]

# ── Demo Mode (Open Workspace) ──────────────────────────────────────
DEMO_MODE=true
DEMO_COMPANY_ID=1
VITE_DEMO_MODE=true

# ── Frontend (exposed to browser) ──────────────────────────────────
VITE_API_URL=
VITE_KIMI_AUTH_URL=

# ── Backend ────────────────────────────────────────────────────────
NODE_ENV=production
FRONTEND_URL=https://bright-basbousa-82e300.netlify.app
CORS_ORIGIN=https://bright-basbousa-82e300.netlify.app
JWT_SECRET=[COPY FROM SESSION_SECRET]

# ── Optional: Kimi OAuth ───────────────────────────────────────────
# KIMI_AUTH_URL=
# KIMI_OPEN_URL=
# OWNER_UNION_ID=
